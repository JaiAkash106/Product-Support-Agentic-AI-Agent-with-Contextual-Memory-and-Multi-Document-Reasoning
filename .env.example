APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8501

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=512
CONTEXTUALIZER_TEMPERATURE=0.0
CONTEXTUALIZER_MAX_OUTPUT_TOKENS=512

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
MAX_QUERY_LENGTH=500
RAG_RELEVANCE_THRESHOLD=0.35
RAG_CONTEXT_EXPANSION_CHUNKS=2
RETRIEVAL_CANDIDATE_POOL_MULTIPLIER=5
RETRIEVAL_TERM_OVERLAP_BOOST=0.18
RETRIEVAL_EXACT_MATCH_BOOST=0.12
RETRIEVAL_SECTION_TITLE_BOOST=0.06
RETRIEVAL_ADJACENT_CHUNK_WINDOW=1
MEMORY_MAX_TURNS=6
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_FILE_TYPES=.pdf,.txt,.csv
DUPLICATE_UPLOAD_STRATEGY=rename
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
FAISS_INDEX_FILE=index.faiss
FAISS_METADATA_FILE=index.pkl
UPLOAD_MANIFEST_FILE=uploaded_files.json
